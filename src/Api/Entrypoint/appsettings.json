{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5023"
      }
    }
  },
  "NetworkAccess": {
    "Enabled": false,
    "PasswordHash": null,
    "AllowedHosts": [],
    "AllowInsecureHttp": false,
    "MaxFailedLoginAttempts": 5,
    "GlobalMaxFailedLoginAttempts": 20,
    "LockoutMinutes": 15,
    "SessionLifetimeHours": 12
  },
  "Lifecycle": {
    "OpenBrowser": true,
    "BrowserCommand": null,
    "ShutdownTimeoutSeconds": 10
  },
  "Updates": {
    "CheckOnStartup": true,
    "Repository": "DanilChizhikov/termforge",
    "ApiBaseUrl": "https://api.github.com/",
    "CacheMinutes": 360,
    "FailureCacheMinutes": 5,
    "TimeoutSeconds": 10
  }
}
